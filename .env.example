# Endereço do backend, com ou sem /api. No celular, use o IP do computador.
# Exemplo na web local: http://localhost:3000
# Não inclua credenciais nem chaves em EXPO_PUBLIC_*.
EXPO_PUBLIC_API_URL=

# mock mantém a apresentação sem servidor. api envia o cadastro completo à API.
EXPO_PUBLIC_DATA_MODE=mock
